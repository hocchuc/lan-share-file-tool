# User uploaded files & persistent notes (prevents leaking personal media/data)
uploads/*
!uploads/.gitkeep

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Environment files
.env
.env.*
*.local

# IDEs & Editors
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Flutter & Dart local artifacts & cache
flutter_app/.dart_tool/
flutter_app/.flutter-plugins*
flutter_app/.pub-cache/
flutter_app/.pub/
flutter_app/build/

# Android local configurations & secrets
flutter_app/android/local.properties
flutter_app/android/.gradle/
flutter_app/android/.cxx/
flutter_app/android/key.properties
flutter_app/android/**/*.keystore
flutter_app/android/**/*.jks

# iOS / macOS ephemeral & generated files (contain local user paths)
flutter_app/ios/Flutter/Generated.xcconfig
flutter_app/ios/Flutter/flutter_export_environment.sh
flutter_app/ios/Flutter/ephemeral/
flutter_app/ios/Flutter/.last_build_id
flutter_app/ios/Pods/
flutter_app/ios/.symlinks/
flutter_app/macos/Flutter/ephemeral/
flutter_app/macos/Pods/
flutter_app/macos/.symlinks/
flutter_app/windows/flutter/ephemeral/
flutter_app/linux/flutter/ephemeral/
